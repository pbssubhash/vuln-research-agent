# Copy this file to .env and fill in only the services you use:
#   cp .env.example .env
# Never commit .env. The repository's .gitignore excludes it.

# GitHub — optional; increases API search limits.
# Create a fine-grained PAT with PUBLIC repository metadata read access only:
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# NVD — optional; increases NVD from 5 to 50 requests per 30 seconds.
# Request a free key:
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# GreyNoise — required for GNQL scanner IP results in the IoCs column.
# The account/key must include GNQL access. The free public CVE endpoint does
# not return scanner IPs.
# Create/manage keys: https://viz.greynoise.io/account/api-key
GREYNOISE_API_KEY=

# VirusTotal — required for CVE-linked file, comment and indicator results.
# Account/API key: https://www.virustotal.com/gui/my-apikey
# Public API keys may have less CVE search coverage than VT Intelligence.
VIRUSTOTAL_API_KEY=

# ThreatFox (abuse.ch) — required for malware/C2 IOCs tagged with the CVE.
# Free account/Auth-Key: https://auth.abuse.ch/
THREATFOX_API_KEY=

# Exploit-DB, AlienVault OTX, and Shodan CVEDB need no key — always queried.

# X IS INTENTIONALLY NOT STORED HERE.
# The agent uses the official xurl CLI. xurl stores OAuth app credentials and
# refresh tokens in its own protected ~/.xurl store. Follow docs/SETUP.md.
